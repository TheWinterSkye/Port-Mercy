# Port Mercy world heartbeat.
# auto = try Codex App Server first, then use deterministic offline fallback on any failure.
PORT_MERCY_HEARTBEAT_PROVIDER=auto

# One hour in milliseconds. Minimum accepted interval is one minute.
PORT_MERCY_HEARTBEAT_MS=3600000

# Uses the locally authenticated Codex installation / ChatGPT Codex quota.
PORT_MERCY_CODEX_COMMAND=codex app-server
PORT_MERCY_CODEX_MODEL=gpt-5.6-luna
PORT_MERCY_CODEX_EFFORT=low

# Useful while developing: run one heartbeat immediately after the world room starts.
# Leave this at 0 in normal play if you only want the scheduled hourly tick.
PORT_MERCY_HEARTBEAT_BOOT_TICK=0

# Optional. By default the heartbeat gives Codex an empty temp working directory
# instead of the game repository because world simulation does not need repo access.
# PORT_MERCY_CODEX_CWD=C:\\path\\to\\an\\empty\\heartbeat-workspace

# Optional resource root override. Normally auto-detected from the repository root.
# PORT_MERCY_RESOURCES_DIR=C:\path\to\port-mercy\resources

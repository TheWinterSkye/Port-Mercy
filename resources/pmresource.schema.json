{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portmercy.local/schemas/pmresource.schema.json",
  "title": "Port Mercy Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "server"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^pm-[a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "server": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "never",
              "summary",
              "full"
            ]
          }
        }
      }
    },
    "clientActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
